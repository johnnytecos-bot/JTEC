# ========================================================
# j TEC Assistant - Production & Development Environment Template
# NEVER commit real API keys or secrets to GitHub!
# ========================================================

# --------------------------------------------------------
# 1. Google Gemini AI API Configuration (Render Backend)
# --------------------------------------------------------
# Required for text chat streaming, 24kHz Live duplex voice, and memory extraction.
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GOOGLE_API_KEY="your_google_api_key_here"

# --------------------------------------------------------
# 2. Server & Networking Configuration (Render Backend)
# --------------------------------------------------------
# Port for the Express server (Render automatically sets this in production)
PORT=3000
NODE_ENV="development"

# CORS Allowed Origin (set to your GitHub Pages URL in production, or * for all)
# Example: https://johnnytecos.github.io
FRONTEND_URL="*"

# --------------------------------------------------------
# 3. Supabase Cloud Database Configuration
# --------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# Private Service Role Key: Keep securely on Render backend only!
# NEVER expose this key to GitHub Pages frontend.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-private-key"

# --------------------------------------------------------
# 4. Frontend Client Environment Variables (GitHub Pages)
# --------------------------------------------------------
# The public URL of your deployed Render backend (e.g. https://jtec-backend.onrender.com)
# Leave empty during local development so Vite uses relative /api/* paths and local WebSockets.
VITE_API_URL=""

# Public Supabase credentials for client-side persistence (optional)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
